ARG PYTHON_BASE_IMAGE=python:3.14-slim
FROM ${PYTHON_BASE_IMAGE}

ARG PYTHON_BASE_IMAGE
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
RUN case "${PYTHON_BASE_IMAGE}" in *@sha256:*) ;; *) exit 1 ;; esac
COPY requirements.txt requirements.pilot.txt requirements.pilot.lock ./
RUN python -m pip install --no-cache-dir -r requirements.pilot.txt -c requirements.pilot.lock \
    && python -m pip check \
    && python -c 'from pathlib import Path; import subprocess; expected = [line for line in Path("requirements.pilot.lock").read_text().splitlines() if line and not line.startswith("#")]; actual = subprocess.check_output(["python", "-m", "pip", "freeze"], text=True).splitlines(); assert actual == expected, "pilot dependency lock differs from installed packages"'
COPY app/ ./app/

USER 10001:10001
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
