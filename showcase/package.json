    "react-dom": "19.2.8",
    "react-markdown": "9.0.1"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prettier": "3.8.1",
    "typescript": "5.8.2"
  }
}
